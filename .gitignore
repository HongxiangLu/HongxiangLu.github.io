# --- Hugo 默认忽略 ---
# 生成的静态网站 (GitHub Actions 会在云端生成，本地的不需要传)
/public

# Hugo 生成的资源缓存 (加快本地构建用的，不必上传)
/resources/_gen

# Hugo 构建锁文件
.hugo_build.lock

# --- 操作系统生成的垃圾文件 ---
# Mac 系统
.DS_Store
.AppleDouble
.LSOverride

# Windows 系统
Thumbs.db
ehthumbs.db
Desktop.ini

# --- 编辑器配置 (可选，保持仓库纯净) ---
.vscode/
.idea/

# --- 脚本diary_bot.py（用于自动上传日记）的配置变量 ---
config.py

# Python 编译文件
__pycache__/
*.py[cod]
*$py.class
